# Copie para .env e preencha. NUNCA comite o .env real.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...            # anon public key (ou service_role se for privado do servidor)

# Navegador
HEADLESS=true                          # false para ver o Chromium (útil no pareamento local)
NAV_TIMEOUT_MS=30000

# Ciclos
LIST_REFRESH_MS=45000                  # reconciliar a lista de eventos
PER_EVENT_DWELL_MS=6000                # tempo lendo cada evento por visita
STALE_SECONDS=20

# Pareamento
PAIRING_WAIT_MS=180000                 # janela para você parear no app MyLapTime
PAIRING_CODE_FILE=pairing-code.txt

# Servidor de status/pareamento (opcional). 0 = desligado.
# Na nuvem headless, abra http://host:PORT para ver o QR/código e as estatísticas.
PORT=0

# Captura
CAPTURE_LAPS=true
MAX_EVENTS_PER_CYCLE=0                  # 0 = todos os ativos
PRIORITY_TRACKS=FKI,Linhares           # substrings priorizadas (opcional)

DEBUG=false
DATA_DIR=data
