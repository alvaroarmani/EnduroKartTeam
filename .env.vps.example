# Copie para .env no VPS (ao lado do docker-compose.yml).

# Pareamento pra sempre (RECOMENDADO): pareie 1x no seu PC (aba Parear), pegue o token de
# data/section-token.txt e cole aqui. O VPS entra JÁ PAREADO, sem escanear nada, e sobrevive
# a restart/redeploy. Se um dia expirar, pareie de novo e atualize o token.
SECTION_ACCESS_TOKEN=

# Opcional: grava também no Supabase (senão grava em data/*.jsonl).
SUPABASE_URL=
SUPABASE_KEY=
